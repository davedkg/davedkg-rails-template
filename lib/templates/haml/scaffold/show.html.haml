.card.bg-1.mb-3
  .card-body
    .d-flex.flex-row.justify-content-between.align-items-center
      %div
        %h5.mb-1= page_title
        = render 'breadcrumbs'
      %div
        %button.btn.btn-solid.theme-primary.btn-lg{ "aria-expanded" => "false", "data-bs-toggle" => "menu", type: "button" }
          %i.bi.bi-three-dots-vertical
        .menu
          - if policy(@<%= singular_table_name %>).edit?
            = link_to edit_<%= singular_table_name %>_path(@<%= singular_table_name %>), class: "menu-item" do
              %i.bi.bi-pencil
              Edit
          - if policy(@<%= singular_table_name %>).destroy?
            = link_to @<%= singular_table_name %>, class: "menu-item", "data-turbo-method": :delete, "data-turbo-confirm": "Archive <%= singular_table_name %>?" do
              %i.bi.bi-trash
              Archive

.row.g-2
  %div{ class: "sm:col-12 md:col-6" }
    .card.bg-1
      .card-body
        %dl.mb-0
        <%- attributes.each do |attribute| -%>
          %dt <%= attribute.name.humanize %>
          %dd= @<%= singular_table_name %>.<%= attribute.name %>
        <%- end -%>
