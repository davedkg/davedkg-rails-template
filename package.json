{
  "name": "app",
  "private": "true",
  "engines": {
    "node": "24.22.3",
    "yarn": "1.22.22"
  },
  "dependencies": {
    "autoprefixer": "^10.4.20",
    "bootstrap": "6.0.0-alpha.2",
    "bootstrap-icons": "^1.13.1",
    "nodemon": "^3.1.9",
    "postcss": "^8.5.23",
    "postcss-cli": "^12.0.0",
    "sass": "^1.83.0"
  },
  "scripts": {
    "build:css:compile": "sass ./app/assets/stylesheets/application.bootstrap.scss:./app/assets/builds/application.css --no-source-map --load-path=node_modules --quiet-deps",
    "build:css:prefix": "postcss ./app/assets/builds/application.css --use=autoprefixer --output=./app/assets/builds/application.css",
    "build:css": "yarn build:css:compile && yarn build:css:prefix",
    "watch:css": "nodemon --watch ./app/assets/stylesheets/ --ext scss --exec \"yarn build:css\""
  },
  "browserslist": [
    "chrome >= 138",
    "edge >= 138",
    "firefox >= 147",
    "safari >= 26",
    "ios_saf >= 26"
  ],
  "resolutions": {
    "ansi-styles": "7.0.0",
    "balanced-match": "5.0.0",
    "binary-extensions": "3.2.0",
    "chokidar": "6.0.0",
    "emoji-regex": "11.0.0",
    "glob-parent": "7.0.0",
    "has-flag": "5.0.1",
    "ignore-by-default": "2.1.0",
    "is-binary-path": "3.0.0",
    "minimatch": "11.0.9",
    "nanoid": "6.0.2",
    "node-addon-api": "8.9.2",
    "string-width": "9.0.0",
    "supports-color": "11.0.0",
    "wrap-ansi": "10.0.2"
  }
}
