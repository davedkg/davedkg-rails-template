.card.bg-1.mb-3
  .card-body
    .row
      .col.d-flex.align-items-center
        %h3.mb-0.fg-emphasis-secondary= page_title
      .col.d-flex.justify-content-end.align-items-center
        - if policy(User).new?
          = link_to new_user_path, class: "btn btn-solid theme-primary btn-lg" do
            %i.bi.bi-plus-lg
            .d-none{ class: "sm:d-inline" }
              User

.table-responsive.table-with-out-card-body{ id: "users-table" }
  %table.table.table-striped
    %thead
      %tr
        %th.d-none{ class: "md:d-table-cell" } State
        %th Name
        %th &nbsp;
    %tbody{ id: "users-table-rows" }
      = render 'users'
= turbo_frame_tag "users-paginator" do
  = render "paginator"
