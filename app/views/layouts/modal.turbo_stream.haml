= turbo_stream.replace :modal do
  = turbo_frame_tag :modal do
    %dialog.dialog{ class: modal_size_class(@modal_size), data: { controller: "remote-modal" } }
      .dialog-header
        %h5.dialog-title= page_title
        %button.btn-close{ "aria-label" => "Close", "data-bs-dismiss" => "dialog", type: "button" }
      = turbo_frame_tag "modal-content" do
        = yield
